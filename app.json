{
  "expo": {
    "name": "on-device-ai",
    "slug": "on-device-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ondeviceai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.jkanyiri.ondeviceai",
      "appleTeamId": "67LVQ2FGUZ",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connects to the benchmark driver on your Mac to run on-device model benchmarks.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "enableSceneSupport": true
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "iosMicrophonePermission": "Voice input is transcribed on this iPhone. Audio never leaves the device.",
          "disableFFmpeg": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos for the on-device vision model to look at. Photos never leave this iPhone.",
          "cameraPermission": "Take a photo for the on-device vision model to look at. Photos never leave this iPhone.",
          "microphonePermission": "Voice input is transcribed on this iPhone. Audio never leaves the device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
